# Copy to `.env` beside compose.yaml and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. These two variables become the first administrator
# account, created on the server's first start against an empty database. After
# that they are ignored: the account lives in the database, and changing the
# password here has no effect.
#
# The server refuses to start when either is missing, rather than falling back
# to a default. On a machine reachable from the internet, a default admin
# password is the same thing as no admin password at all.

# 3-32 characters, letters/digits/dot/dash/underscore only.
ROOT_USERNAME=root

# At least 4 characters. This account can read the audit log and disable every
# other user, so on a site anyone can reach, pick something long — the length
# floor is low so that a short one is *possible*, not because it is advisable.
ROOT_PASSWORD=replace-me-with-something-long-and-random
